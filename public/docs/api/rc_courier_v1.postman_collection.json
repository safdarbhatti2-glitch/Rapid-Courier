{
  "info": {
    "name": "RC Courier UAE REST API (v1)",
    "description": "Postman Collection for RC Courier UAE REST API v1. Includes Quotes, Shipments, Tracking, Invoices, Thermal Labels, Webhooks, and Account endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://rapid-courier.com/api/v1" },
    { "key": "api_key", "value": "rc_live_7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c" },
    { "key": "api_secret", "value": "sec_a1b2c3d4e5f678901234567890abcdef" },
    { "key": "tracking_number", "value": "RC41105043" },
    { "key": "shipment_id", "value": "1" },
    { "key": "invoice_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Public Tracking",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/tracking/{{tracking_number}}",
          "host": ["{{base_url}}"],
          "path": ["tracking", "{{tracking_number}}"]
        }
      }
    },
    {
      "name": "Calculate Instant Quote",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service\": \"express_same_day\",\n  \"origin_emirate\": \"Dubai\",\n  \"destination_emirate\": \"Abu Dhabi\",\n  \"weight_kg\": 2.5,\n  \"length_cm\": 25,\n  \"width_cm\": 15,\n  \"height_cm\": 10,\n  \"declared_value\": 250.00\n}"
        },
        "url": {
          "raw": "{{base_url}}/quotes",
          "host": ["{{base_url}}"],
          "path": ["quotes"]
        }
      }
    },
    {
      "name": "Create Shipment (Book Delivery)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" },
          { "key": "Idempotency-Key", "value": "ik_98412503_test" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"service\": \"express_same_day\",\n  \"origin_emirate\": \"Dubai\",\n  \"destination_emirate\": \"Sharjah\",\n  \"sender\": {\n    \"name\": \"ABC Trading LLC\",\n    \"phone\": \"+971 4 800 2684\",\n    \"address\": { \"line1\": \"Downtown Dubai\", \"emirate\": \"Dubai\" }\n  },\n  \"receiver\": {\n    \"name\": \"Fatima Al-Nuaimi\",\n    \"phone\": \"+971 50 987 6543\",\n    \"address\": { \"line1\": \"Al Qasimia\", \"emirate\": \"Sharjah\" }\n  },\n  \"package\": {\n    \"description\": \"Electronics Parts\",\n    \"weight_kg\": 1.5,\n    \"pieces\": 1,\n    \"declared_value\": 100.00\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/shipments",
          "host": ["{{base_url}}"],
          "path": ["shipments"]
        }
      }
    },
    {
      "name": "List Shipments",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" }
        ],
        "url": {
          "raw": "{{base_url}}/shipments?page=1&limit=20",
          "host": ["{{base_url}}"],
          "path": ["shipments"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "Get Shipment Details",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" }
        ],
        "url": {
          "raw": "{{base_url}}/shipments/{{shipment_id}}",
          "host": ["{{base_url}}"],
          "path": ["shipments", "{{shipment_id}}"]
        }
      }
    },
    {
      "name": "Get 4x6 Thermal Label HTML",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" }
        ],
        "url": {
          "raw": "{{base_url}}/shipments/{{shipment_id}}/label/thermal",
          "host": ["{{base_url}}"],
          "path": ["shipments", "{{shipment_id}}", "label", "thermal"]
        }
      }
    },
    {
      "name": "Download Tax Invoice",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" }
        ],
        "url": {
          "raw": "{{base_url}}/invoices/{{invoice_id}}/download",
          "host": ["{{base_url}}"],
          "path": ["invoices", "{{invoice_id}}", "download"]
        }
      }
    },
    {
      "name": "Register Webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://my-store.com/api/rc-webhook\",\n  \"events\": [\"shipment.created\", \"shipment.delivered\", \"shipment.cancelled\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhooks",
          "host": ["{{base_url}}"],
          "path": ["webhooks"]
        }
      }
    },
    {
      "name": "Get Account Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-API-Key", "value": "{{api_key}}" },
          { "key": "X-API-Secret", "value": "{{api_secret}}" }
        ],
        "url": {
          "raw": "{{base_url}}/account",
          "host": ["{{base_url}}"],
          "path": ["account"]
        }
      }
    }
  ]
}
